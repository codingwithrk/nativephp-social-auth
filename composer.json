{
    "name": "codingwithrk/nativephp-social-auth",
    "description": "Native Apple Sign-In and Google Sign-In for NativePHP Mobile apps.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "social-auth",
        "apple-sign-in",
        "google-sign-in",
        "mobile",
        "laravel",
        "ios",
        "android"
    ],
    "authors": [
        {
            "name": "Your Name",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0|^4.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Codingwithrk\\NativephpSocialAuth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codingwithrk\\NativephpSocialAuth\\NativephpSocialAuthServiceProvider"
            ],
            "aliases": {
                "NativephpSocialAuth": "Codingwithrk\\NativephpSocialAuth\\Facades\\NativephpSocialAuth"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
